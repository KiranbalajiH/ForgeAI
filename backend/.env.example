# ===========================
# Server
# ===========================
PORT=5000

# ===========================
# Database
# ===========================
DATABASE_URL="postgresql://postgres:postgresql@localhost:5432/forgeai"

# ===========================
# Authentication
# ===========================
JWT_SECRET="change-this-to-a-long-random-secret"

# ===========================
# AI Providers
# ===========================
# ForgeAI uses OpenRouter by default
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=your_preferred_model

# Provider specific keys (Optional, required if directly using their API without OpenRouter)
OPENAI_API_KEY=your_openai_key
NVIDIA_API_KEY=your_nvidia_nim_key
QWEN_API_KEY=your_qwen_key

# Optional (recommended by OpenRouter)
APP_NAME=ForgeAI
APP_URL=http://localhost:3000
