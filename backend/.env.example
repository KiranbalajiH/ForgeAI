# ===========================
# Server
# ===========================
PORT=5000

# ===========================
# Database
# ===========================
DATABASE_URL="postgresql://postgres:postgresql@localhost:5432/rag_assistant"

# ===========================
# Authentication
# ===========================
JWT_SECRET="change-this-to-a-long-random-secret"

# ===========================
# AI Providers
# ===========================
# OpenRouter API (Default)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=your_preferred_model

# Direct AI Provider Keys (Optional)
OPENAI_API_KEY=your_openai_key
NVIDIA_API_KEY=your_nvidia_nim_key
QWEN_API_KEY=your_qwen_key

# ===========================
# Web Search & External Tools
# ===========================
# Tavily Web Search API Key (Optional - Wikipedia & DuckDuckGo APIs used automatically if omitted)
TAVILY_API_KEY=your_tavily_api_key

# App Information
APP_NAME=Agentic RAG Knowledge Assistant
APP_URL=http://localhost:3000
